CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CF_ACCESS_AUDIENCE=replace_with_dashboard_access_audience
CF_DEVICE_SERVICE_CLIENT_ID=replace_with_service_token_client_id
# The current recording key is a separate 32-byte base64 secret in
# deploy/secrets/recording-encryption-key.b64. Key-version and previous-key
# settings belong in a deployment-specific secret override; see docs/DEPLOYMENT.md.
